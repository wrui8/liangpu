# 复制本文件为 .env，并按需修改（.env 不会提交到 Git）
#
# 生成新的 JWT 密钥（每台部署机器生成一次，改后所有人需重新登录）：
#   Linux/macOS:  openssl rand -hex 32
#   Windows:      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-64-hex-string

# 可选：需求总分中“自身评分”权重，默认 0.7（成员表现分占 0.3）
# NEED_SELF_WEIGHT=0.7
